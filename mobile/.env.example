# URL base del backend Express (carpeta `web/`).
#
# Si se omite, la app toma la IP del bundler de Metro y usa el puerto 3000,
# lo que funciona en Expo Go cuando el teléfono y el PC están en la misma red.
#
# Para un emulador, un dispositivo en otra red o un backend desplegado,
# define la URL completa:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
